rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // --- Crops Collection ---
    match /crops/{cropId} {
      // Anyone logged in can browse the marketplace
      allow read: if isAuthenticated();
      // Only the farmer who owns the crop can create/edit/delete it
      allow create: if isAuthenticated() && request.resource.data.farmerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.farmerId == request.auth.uid;
    }

    // --- Contracts Collection ---
    match /contracts/{contractId} {
      // Only the involved buyer or farmer can see the contract
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.farmerId == request.auth.uid
      );
      // Buyer creates contract, Farmer accepts (updates) it
      allow create: if isAuthenticated() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.farmerId == request.auth.uid
      );
    }

    // --- Negotiations Collection ---
    match /negotiations/{negId} {
      // Only the involved parties can see the negotiation
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.farmerId == request.auth.uid
      );
      // Allow create only if the user is one of the parties
      allow create: if isAuthenticated() && (
        request.resource.data.buyerId == request.auth.uid || 
        request.resource.data.farmerId == request.auth.uid
      );
      // Allow update if the user is one of the parties (check existing doc)
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.farmerId == request.auth.uid
      );
    }

    // --- Payments Collection ---
    match /payments/{paymentId} {
      // Only the involved parties can see payments
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.farmerId == request.auth.uid
      );
      // Buyer or system creates payment
      allow create: if isAuthenticated() && (
        request.resource.data.buyerId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid
      );
    }

    // --- Messages Collection ---
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
    }
  }
}