rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // --- Crops Collection ---
    match /crops/{cropId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.farmerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.farmerId == request.auth.uid;
    }

    // --- Contracts Collection ---
    match /contracts/{contractId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.farmerId == request.auth.uid
      );
      // Buyer creates a proposal OR farmer creates directly when accepting an offer
      allow create: if isAuthenticated() && (
        request.resource.data.buyerId == request.auth.uid ||
        request.resource.data.farmerId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.farmerId == request.auth.uid
      );
    }

    // --- Negotiations Collection ---
    match /negotiations/{negId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.farmerId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.buyerId == request.auth.uid || 
        request.resource.data.farmerId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.farmerId == request.auth.uid
      );
    }

    // --- Payments Collection ---
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.farmerId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.buyerId == request.auth.uid ||
        request.resource.data.farmerId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.farmerId == request.auth.uid
      );
    }

    // --- Notifications Collection ---
    // Any authenticated user can create a notification for any other user.
    // Users can only read/update/delete their own notifications.
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }

    // --- Messages Collection ---
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
    }
  }
}