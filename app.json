{
  "expo": {
    "name": "Farmer Buyer Contract",
    "slug": "farmer-buyer-contract",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#4CAF50"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.farmerbuyer.contract"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/logo.png",
        "backgroundColor": "#4CAF50"
      },
      "package": "com.farmerbuyer.contract"
    },
    "web": {
      "favicon": "./src/assets/images/logo.png"
    },
    "plugins": [
      "expo-localization"
    ]
  }
}
